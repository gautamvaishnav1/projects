{
  "name": "software-world-backend",
  "version": "0.1.0",
  "description": "AI-powered Software World backend: GitHub repo -> AST analysis -> architecture graph -> 3D frontend + AI chat (hackathon MVP)",
  "main": "dist/server.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "nodemailer": "^9.0.5",
    "socket.io": "^4.8.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.12",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
