{
  "_readme": "Complete API inventory for Software World backend. Import-friendly JSON: every request with method (type), path, full local URL, auth requirement, body template and expected status.",
  "baseUrl": "http://localhost:5000",
  "authHeader": "Authorization: Bearer <token from login/register>",
  "totalRequests": 23,
  "groups": {
    "health": [
      {
        "name": "Health check",
        "method": "GET",
        "path": "/health",
        "url": "http://localhost:5000/health",
        "auth": false,
        "body": null,
        "expectedStatus": 200
      }
    ],
    "auth": [
      {
        "name": "Register (sends OTP to email)",
        "method": "POST",
        "path": "/api/v1/auth/register",
        "url": "http://localhost:5000/api/v1/auth/register",
        "auth": false,
        "body": { "name": "Demo", "email": "you@test.com", "password": "passw0rd123" },
        "expectedStatus": 201,
        "note": "Returns devCode instead of email when SMTP is not configured (dev only)."
      },
      {
        "name": "Verify OTP (returns JWT)",
        "method": "POST",
        "path": "/api/v1/auth/verify-otp",
        "url": "http://localhost:5000/api/v1/auth/verify-otp",
        "auth": false,
        "body": { "email": "you@test.com", "code": "123456" },
        "expectedStatus": 200
      },
      {
        "name": "Resend OTP",
        "method": "POST",
        "path": "/api/v1/auth/resend-otp",
        "url": "http://localhost:5000/api/v1/auth/resend-otp",
        "auth": false,
        "body": { "email": "you@test.com" },
        "expectedStatus": 200,
        "note": "60s cooldown -> 429."
      },
      {
        "name": "Login",
        "method": "POST",
        "path": "/api/v1/auth/login",
        "url": "http://localhost:5000/api/v1/auth/login",
        "auth": false,
        "body": { "email": "you@test.com", "password": "passw0rd123" },
        "expectedStatus": 200,
        "note": "403 needsVerification:true if account not OTP-verified yet."
      },
      {
        "name": "Forgot password (sends reset OTP)",
        "method": "POST",
        "path": "/api/v1/auth/forgot-password",
        "url": "http://localhost:5000/api/v1/auth/forgot-password",
        "auth": false,
        "body": { "email": "you@test.com" },
        "expectedStatus": 200
      },
      {
        "name": "Reset password with OTP",
        "method": "POST",
        "path": "/api/v1/auth/reset-password",
        "url": "http://localhost:5000/api/v1/auth/reset-password",
        "auth": false,
        "body": { "email": "you@test.com", "code": "123456", "newPassword": "newpass9x" },
        "expectedStatus": 200
      },
      {
        "name": "Google OAuth - start redirect flow",
        "method": "GET",
        "path": "/api/v1/auth/google",
        "url": "http://localhost:5000/api/v1/auth/google",
        "auth": false,
        "body": null,
        "expectedStatus": 302,
        "note": "Open in browser; requires GOOGLE_CLIENT_ID."
      },
      {
        "name": "Google OAuth - callback (browser only)",
        "method": "GET",
        "path": "/api/v1/auth/google/callback",
        "url": "http://localhost:5000/api/v1/auth/google/callback",
        "auth": false,
        "body": null,
        "expectedStatus": 302
      },
      {
        "name": "Google OAuth - SPA login with ID token",
        "method": "POST",
        "path": "/api/v1/auth/google",
        "url": "http://localhost:5000/api/v1/auth/google",
        "auth": false,
        "body": { "credential": "<GOOGLE_ID_TOKEN>" },
        "expectedStatus": 200
      },
      {
        "name": "GitHub OAuth - start redirect flow",
        "method": "GET",
        "path": "/api/v1/auth/github",
        "url": "http://localhost:5000/api/v1/auth/github",
        "auth": false,
        "body": null,
        "expectedStatus": 302,
        "note": "Requires GITHUB_CLIENT_ID/SECRET."
      },
      {
        "name": "GitHub OAuth - callback (browser only)",
        "method": "GET",
        "path": "/api/v1/auth/github/callback",
        "url": "http://localhost:5000/api/v1/auth/github/callback",
        "auth": false,
        "body": null,
        "expectedStatus": 302
      },
      {
        "name": "GitHub OAuth - SPA exchange code",
        "method": "POST",
        "path": "/api/v1/auth/github",
        "url": "http://localhost:5000/api/v1/auth/github",
        "auth": false,
        "body": { "code": "<AUTH_CODE_FROM_REDIRECT>" },
        "expectedStatus": 200
      },
      {
        "name": "My profile",
        "method": "GET",
        "path": "/api/v1/auth/me",
        "url": "http://localhost:5000/api/v1/auth/me",
        "auth": true,
        "body": null,
        "expectedStatus": 200
      }
    ],
    "projects": [
      {
        "name": "Create project (submit GitHub repo URL)",
        "method": "POST",
        "path": "/api/v1/projects",
        "url": "http://localhost:5000/api/v1/projects",
        "auth": true,
        "body": { "name": "My Repo", "description": "optional", "repoUrl": "https://github.com/hagopj13/node-express-mongoose-boilerplate" },
        "expectedStatus": 201,
        "note": "409 if you already created a project for this URL."
      },
      {
        "name": "List my projects",
        "method": "GET",
        "path": "/api/v1/projects",
        "url": "http://localhost:5000/api/v1/projects",
        "auth": true,
        "body": null,
        "expectedStatus": 200
      },
      {
        "name": "Get project detail",
        "method": "GET",
        "path": "/api/v1/projects/:projectId",
        "url": "http://localhost:5000/api/v1/projects/<projectId>",
        "auth": true,
        "body": null,
        "expectedStatus": 200
      },
      {
        "name": "Delete project (+ its analyses)",
        "method": "DELETE",
        "path": "/api/v1/projects/:projectId",
        "url": "http://localhost:5000/api/v1/projects/<projectId>",
        "auth": true,
        "body": null,
        "expectedStatus": 200
      }
    ],
    "analysis": [
      {
        "name": "Start repository analysis (async pipeline)",
        "method": "POST",
        "path": "/api/v1/projects/:projectId/analyze",
        "url": "http://localhost:5000/api/v1/projects/<projectId>/analyze",
        "auth": true,
        "body": null,
        "expectedStatus": 202,
        "note": "Progress via Socket.IO room project:<projectId>; poll status endpoint as fallback."
      },
      {
        "name": "Get analysis status (polling)",
        "method": "GET",
        "path": "/api/v1/analyses/:analysisId/status",
        "url": "http://localhost:5000/api/v1/analyses/<analysisId>/status",
        "auth": true,
        "body": null,
        "expectedStatus": 200
      },
      {
        "name": "Get full analysis (metadata + architecture)",
        "method": "GET",
        "path": "/api/v1/analyses/:analysisId",
        "url": "http://localhost:5000/api/v1/analyses/<analysisId>",
        "auth": true,
        "body": null,
        "expectedStatus": 200
      },
      {
        "name": "Get latest architecture (3D graph payload)",
        "method": "GET",
        "path": "/api/v1/projects/:projectId/architecture",
        "url": "http://localhost:5000/api/v1/projects/<projectId>/architecture",
        "auth": true,
        "body": null,
        "expectedStatus": 200,
        "note": "components[] + connections[] — render this in Three.js."
      }
    ],
    "aiChat": [
      {
        "name": "Ask question about architecture",
        "method": "POST",
        "path": "/api/v1/projects/:projectId/chat",
        "url": "http://localhost:5000/api/v1/projects/<projectId>/chat",
        "auth": true,
        "body": { "question": "How does authentication work?" },
        "expectedStatus": 200,
        "note": "Returns answer, targetComponent, path[], relatedComponents[]. Also emits character:explain on the socket room."
      }
    ]
  },
  "socketIO": {
    "url": "http://localhost:5000",
    "handshakeAuth": { "token": "<JWT>" },
    "clientToServer": [
      { "event": "project:join", "payload": { "projectId": "<projectId>" } },
      { "event": "character:move", "payload": { "projectId": "<projectId>", "toComponentId": "auth-routes" } },
      { "event": "character:explain", "payload": { "projectId": "<projectId>", "path": ["frontend", "auth-routes"] } }
    ],
    "serverToClient": [
      "analysis:started",
      "analysis:progress",
      "analysis:completed",
      "analysis:failed",
      "character:move",
      "character:explain"
    ]
  }
}

